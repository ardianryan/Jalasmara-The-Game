extends SceneTree

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var clock:=root.get_node("EnvironmentState")
	clock.set_process(false)
	clock.clock_paused=true
	clock.apply_calendar({"calendarRevision":1,"calendarDay":3,"minuteOfDay":720.0,"weather":{"raining":false}})
	var noon: Dictionary=clock.snapshot()
	assert(is_equal_approx(float(noon.daylight),1.0) and is_equal_approx(float(noon.presentedDaylight),1.0),"First authoritative sync must initialize the presented light without a startup flash")
	var effects=load("res://scripts/EnvironmentEffects.gd").new()
	effects.configure("forest")
	root.add_child(effects)
	var expected: Color=effects.tint_for("forest",float(noon.presentedDaylight),float(noon.clouds))
	assert(effects._tint.is_equal_approx(expected) and effects._modulate.color.is_equal_approx(expected),"Scene entry must initialize its tint from the current presented light")
	clock.apply_calendar({"calendarRevision":2,"calendarDay":3,"minuteOfDay":1080.0,"weather":{"raining":false}})
	var shifted: Dictionary=clock.snapshot()
	assert(float(shifted.daylight)<.4 and is_equal_approx(float(shifted.presentedDaylight),1.0),"A kedai shift must change authoritative time without cutting visual light")
	clock._process(1.0/60.0)
	var first: Dictionary=clock.snapshot()
	assert(float(first.presentedDaylight)<1.0 and float(first.presentedDaylight)>.98,"One frame of a six-hour shift must be a small, visible fade")
	assert(float(first.presentedMinuteOfDay)>720.0 and float(first.presentedMinuteOfDay)<730.0,"The sunset hue clock must not jump six hours in one frame")
	var entry=load("res://scripts/EnvironmentEffects.gd").new()
	entry.configure("hub")
	root.add_child(entry)
	expected=entry.tint_for("hub",float(first.presentedDaylight),float(first.clouds))
	assert(entry._tint.is_equal_approx(expected),"Entering another area during a shift must use the ongoing fade")
	for frame in range(180): clock._process(1.0/60.0)
	var after_shift: Dictionary=clock.snapshot()
	assert(float(after_shift.presentedDaylight)<.43,"The evening look must finish settling within three seconds")
	clock.apply_calendar({"calendarRevision":3,"calendarDay":3,"minuteOfDay":960.0,"weather":{"raining":false}})
	var before_correction: Dictionary=clock.snapshot()
	clock._process(1.0/60.0)
	var correction: Dictionary=clock.snapshot()
	assert(float(correction.minuteOfDay)==960.0 and float(correction.presentedMinuteOfDay)<float(before_correction.presentedMinuteOfDay),"A backward heartbeat correction must change gameplay immediately and visual time gradually")
	assert(float(correction.presentedDaylight)>float(before_correction.presentedDaylight),"The visual light must begin returning toward afternoon")
	var wrapped: float=clock.advance_presented_minutes(1439.0,1.0,1.0/60.0)
	assert(wrapped>1439.0 or wrapped<1.0,"Midnight correction must follow the shortest cyclic route")
	assert(int(clock.snapshot().calendarDay)==3,"Visual presentation must leave server calendar ownership intact")
	effects.free()
	entry.free()
	print("MOODBOARD CLOCK JUMP VISUAL PASS: shift, rewind, midnight wrap and scene tint")
	quit()
